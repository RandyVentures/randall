---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<dialog class="palette" id="palette" aria-label="Search the site" data-index={`${base}/search.json`}>
	<div class="palette-field">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
		<input
			id="palette-input"
			type="search"
			placeholder="Search entries, apps, pages…"
			autocomplete="off"
			spellcheck="false"
			role="combobox"
			aria-expanded="true"
			aria-controls="palette-list"
			aria-autocomplete="list"
		/>
		<kbd>esc</kbd>
	</div>
	<ul class="palette-results" id="palette-list" role="listbox" aria-label="Results"></ul>
	<div class="palette-foot" aria-hidden="true">
		<span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
		<span><kbd>↵</kbd> open</span>
		<span><kbd>esc</kbd> close</span>
	</div>
</dialog>

<script>
	type Entry = { t: string; d: string; u: string; n: number; date: string; tags: string[]; tone: string };
	type App = { t: string; d: string; u: string; icon: string; k: string };
	type Page = { t: string; d: string; u: string };
	type Index = { posts: Entry[]; apps: App[]; pages: Page[] };
	type Result = { title: string; sub: string; url: string; icon: string; tone?: string; external: boolean };

	const dialog = document.getElementById('palette') as HTMLDialogElement;
	const input = document.getElementById('palette-input') as HTMLInputElement;
	const list = document.getElementById('palette-list') as HTMLUListElement;

	let index: Index | null = null;
	let results: Result[] = [];
	let active = 0;

	const escapeHtml = (s: string) =>
		s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

	function highlight(text: string, terms: string[]) {
		let html = escapeHtml(text);
		for (const term of terms) {
			if (!term) continue;
			const safe = escapeHtml(term).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
			html = html.replace(new RegExp(`(${safe})`, 'ig'), '<mark>$1</mark>');
		}
		return html;
	}

	/** Every term must match somewhere; title hits count most. */
	function score(title: string, rest: string, terms: string[]) {
		const t = title.toLowerCase();
		const r = rest.toLowerCase();
		let total = 0;
		for (const term of terms) {
			if (t.startsWith(term)) total += 12;
			else if (t.includes(` ${term}`)) total += 9;
			else if (t.includes(term)) total += 6;
			else if (r.includes(term)) total += 2;
			else return 0;
		}
		return total;
	}

	async function load() {
		if (index) return index;
		const res = await fetch(dialog.dataset.index!);
		index = (await res.json()) as Index;
		return index;
	}

	function render(query: string) {
		if (!index) {
			list.innerHTML = '<li class="palette-empty" role="presentation">Loading…</li>';
			return;
		}
		const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
		const groups: [string, Result[]][] = [];

		const posts = terms.length
			? index.posts
					.map((p) => ({ p, s: score(p.t, `${p.d} ${p.tags.join(' ')}`, terms) }))
					.filter((x) => x.s > 0)
					.sort((a, b) => b.s - a.s)
					.slice(0, 7)
					.map((x) => x.p)
			: index.posts.slice(0, 5);
		groups.push([
			terms.length ? 'Entries' : 'Latest entries',
			posts.map((p) => ({
				title: p.t,
				sub: `${p.date} · ${p.tags.join(', ')}`,
				url: p.u,
				icon: String(p.n).padStart(3, '0'),
				tone: p.tone,
				external: false,
			})),
		]);

		if (terms.length) {
			const apps = index.apps
				.map((a) => ({ a, s: score(a.t, `${a.d} ${a.k}`, terms) }))
				.filter((x) => x.s > 0)
				.sort((a, b) => b.s - a.s)
				.slice(0, 4)
				.map((x) => x.a);
			groups.push([
				'Apps',
				apps.map((a) => ({
					title: a.t,
					sub: a.d,
					url: a.u,
					icon: `<img src="${a.icon}" alt="" width="36" height="36" loading="lazy">`,
					external: a.u.startsWith('http'),
				})),
			]);
		}

		const pages = terms.length
			? index.pages.filter((p) => score(p.t, p.d, terms) > 0)
			: index.pages;
		groups.push([
			'Pages',
			pages.map((p) => ({ title: p.t, sub: p.d, url: p.u, icon: '→', external: false })),
		]);

		results = groups.flatMap(([, items]) => items);
		active = 0;

		if (!results.length) {
			list.innerHTML = `<li class="palette-empty" role="presentation">Nothing matches “${escapeHtml(query)}”. Try a tag like <em>apps</em> or <em>family</em>.</li>`;
			input.removeAttribute('aria-activedescendant');
			return;
		}

		let i = 0;
		list.innerHTML = groups
			.filter(([, items]) => items.length)
			.map(
				([label, items]) =>
					`<li class="palette-group" role="presentation">${label}</li>` +
					items
						.map((item) => {
							const id = `palette-opt-${i++}`;
							return `<li class="palette-item" role="presentation"><a id="${id}" role="option" href="${item.url}"${item.external ? ' target="_blank" rel="noopener"' : ''} aria-selected="false" tabindex="-1"><span class="palette-icon"${item.tone ? ` data-tone="${item.tone}"` : ''}>${item.icon}</span><span class="palette-text"><span class="palette-title">${highlight(item.title, terms)}</span><span class="palette-sub">${escapeHtml(item.sub)}</span></span><span class="palette-go" aria-hidden="true">↵</span></a></li>`;
						})
						.join(''),
			)
			.join('');
		select(0);
	}

	function select(next: number) {
		const options = list.querySelectorAll<HTMLAnchorElement>('[role="option"]');
		if (!options.length) return;
		active = (next + options.length) % options.length;
		options.forEach((o, n) => o.setAttribute('aria-selected', String(n === active)));
		const current = options[active];
		input.setAttribute('aria-activedescendant', current.id);
		current.scrollIntoView({ block: 'nearest' });
	}

	async function open() {
		if (dialog.open) return;
		dialog.showModal();
		input.value = '';
		render('');
		await load();
		render(input.value);
	}

	input.addEventListener('input', () => render(input.value));
	input.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowDown') {
			event.preventDefault();
			select(active + 1);
		} else if (event.key === 'ArrowUp') {
			event.preventDefault();
			select(active - 1);
		} else if (event.key === 'Enter') {
			const option = list.querySelectorAll<HTMLAnchorElement>('[role="option"]')[active];
			if (option) {
				event.preventDefault();
				option.click();
			}
		}
	});
	list.addEventListener('mousemove', (event) => {
		const option = (event.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]');
		if (!option) return;
		const options = [...list.querySelectorAll('[role="option"]')];
		const n = options.indexOf(option);
		if (n !== active) select(n);
	});
	// Clicking the dimmed backdrop closes, like every other palette people know.
	dialog.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	document.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('[data-open-search]')) {
			event.preventDefault();
			open();
		}
	});
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			dialog.open ? dialog.close() : open();
			return;
		}
		const target = event.target as HTMLElement;
		const typing = target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
		// The log page claims "/" for its own filter field.
		if (event.key === '/' && !typing && !dialog.open && !document.querySelector('[data-slash-focus]')) {
			event.preventDefault();
			open();
		}
	});
</script>
