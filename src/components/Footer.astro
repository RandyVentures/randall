---
import { SITE_TITLE } from '../consts';

const today = new Date();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-about">
			<a class="brand" href={withBase('/')} aria-label={`${SITE_TITLE} — home`}>
				<span class="brand-mark" aria-hidden="true">R</span>
				<span class="brand-text">
					<span class="brand-name">{SITE_TITLE}</span>
					<span class="brand-sub">Field notes · South Texas</span>
				</span>
			</a>
			<p>
				A public log of building technology, wealth, and a meaningful family life — apps, AI, rentals,
				faith, and the lessons in between. Written from McAllen, Texas.
			</p>
			<a class="button small ghost" href={withBase('/rss.xml')}>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14"><path fill="currentColor" d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"></path></svg>
				Subscribe via RSS
			</a>
		</div>
		<nav class="footer-col" aria-labelledby="footer-read">
			<h2 id="footer-read">Read</h2>
			<ul>
				<li><a href={withBase('/blog')}>The log</a></li>
				<li><a href={withBase('/#apps')}>Apps</a></li>
				<li><a href={withBase('/#playbooks')}>Playbooks</a></li>
				<li><a href={withBase('/about')}>About</a></li>
				<li><a href="#" data-open-search>Search</a></li>
			</ul>
		</nav>
		<nav class="footer-col" aria-labelledby="footer-elsewhere">
			<h2 id="footer-elsewhere">Elsewhere</h2>
			<ul>
				<li><a href="https://github.com/RandyVentures" target="_blank" rel="noopener">GitHub ↗</a></li>
				<li><a href="https://www.linkedin.com/in/randy-torres-987a3761" target="_blank" rel="noopener">LinkedIn ↗</a></li>
				<li><a href="https://apps.apple.com/us/developer/randy-torres/id1871953838" target="_blank" rel="noopener">App Store ↗</a></li>
				<li><a href="https://randyverse768.gumroad.com" target="_blank" rel="noopener">Gumroad ↗</a></li>
			</ul>
		</nav>
	</div>
	<div class="footer-base">
		<span>&copy; {today.getFullYear()} Randall Ventures</span>
		<span>Set in Fraunces, Newsreader &amp; Geist · Built with Astro</span>
	</div>
</footer>
