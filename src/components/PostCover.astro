---
import { Image } from 'astro:assets';
import { primaryTone } from '../data/tags';
import type { Post } from '../lib/posts';

interface Props {
	post: Post;
	n: number;
	/** Rendered width of the optimized image; height follows the source ratio. */
	width?: number;
	sizes?: string;
	eager?: boolean;
	class?: string;
}

const { post, n, width = 720, sizes, eager = false, class: className } = Astro.props;
const { heroImage, tags, pubDate } = post.data;

/*
  Posts without a photo get generated art instead of an empty box: a South Texas
  sunset in the post's topic color, laid out from a hash of its slug so every
  entry is different but never changes between builds.
*/
let hash = 2166136261;
for (const ch of post.id) hash = Math.imul(hash ^ ch.charCodeAt(0), 16777619) >>> 0;
const pick = (shift: number, min: number, span: number) => min + ((hash >>> shift) % span);

const horizon = pick(0, 150, 30);
// Kept left of x≈300 so square crops (which anchor left) still show the sun.
const sun = { cx: pick(5, 170, 120), r: pick(11, 44, 34) };
const sunCy = horizon - pick(17, 0, Math.max(1, sun.r - 10));
const bands = [3, 5, 8, 12, 18];
const month = pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const number = String(n).padStart(3, '0');
---

<span class:list={['cover', className]} data-tone={primaryTone(tags)}>
	{
		heroImage ? (
			<Image
				src={heroImage}
				width={width}
				sizes={sizes}
				alt=""
				loading={eager ? 'eager' : 'lazy'}
				fetchpriority={eager ? 'high' : undefined}
			/>
		) : (
			<svg class="cover-art" viewBox="0 0 400 250" preserveAspectRatio="xMinYMax slice" aria-hidden="true">
				<rect class="art-bg" width="400" height="250" />
				<circle class="art-sun" cx={sun.cx} cy={sunCy} r={sun.r} opacity="0.9" />
				{[0.34, 0.55, 0.76].map((t, i) => (
					<rect class="art-bg" x="0" y={sunCy + sun.r * t - (3 - i)} width="400" height={3 - i + 1.5} />
				))}
				<rect class="art-bg" y={horizon} width="400" height={250 - horizon} />
				{bands.map((h, i) => {
					const y = horizon + 6 + bands.slice(0, i).reduce((sum, b) => sum + b + 6, 0);
					return <rect class="art-band" y={y} width="400" height={h} opacity={0.12 + i * 0.1} />;
				})}
				<text class="art-ink" x="26" y="40" font-size="11" letter-spacing="1.5" opacity="0.8">NO.</text>
				<text class="art-num" x="22" y="100" font-size="66">{number}</text>
				<text class="art-ink" x="26" y={horizon - 14} font-size="10" letter-spacing="1.2" opacity="0.7">
					{month.toUpperCase()}
				</text>
			</svg>
		)
	}
</span>
