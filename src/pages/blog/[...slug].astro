---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type Post, entryNumbers, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: Post };

const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getPosts();
const numbers = entryNumbers(posts);
const index = posts.findIndex((p) => p.id === post.id);
const withNumber = (p?: Post) => p && { post: p, n: numbers.get(p.id)! };

// The list runs newest first, so the older post sits after this one.
const prev = withNumber(posts[index + 1]);
const next = withNumber(posts[index - 1]);

// Closest neighbours by shared tags, most overlap first, newest breaking ties.
// The pager already links the adjacent two, so they are left out here.
const adjacent = new Set([post.id, prev?.post.id, next?.post.id]);
const related = posts
	.filter((other) => !adjacent.has(other.id))
	.map((other) => ({
		other,
		overlap: other.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
	}))
	.filter((entry) => entry.overlap > 0)
	.sort((a, b) => b.overlap - a.overlap)
	.slice(0, 3)
	.map((entry) => withNumber(entry.other)!);
---

<BlogPost post={post} n={numbers.get(post.id)!} headings={headings} prev={prev} next={next} related={related}>
	<Content />
</BlogPost>
