---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/posts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found — ${SITE_TITLE}`} description="That page is not in the log." />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="lost">
				<span class="lost-num reveal" aria-hidden="true">404</span>
				<h1 class="reveal" style="--i: 1">This entry never got written.</h1>
				<p class="lead reveal" style="--i: 2">
					The link may be old, or the page moved. Search the log, or head back to the start.
				</p>
				<div class="hero-actions reveal" style="--i: 3; justify-content: center">
					<button class="button" type="button" data-open-search>Search the site</button>
					<a class="button ghost" href={withBase('/')}>Go home</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
