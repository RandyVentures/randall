---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { RECENTLY_SHIPPED, apps, liveApps } from '../data/apps';
import { playbooks } from '../data/playbooks';
import { entryNumbers, getPosts, withBase } from '../lib/posts';

const posts = await getPosts();
const numbers = entryNumbers(posts);
const [featured, ...rest] = posts;
const recent = rest.slice(0, 3);
const writingSince = posts[posts.length - 1].data.pubDate.toLocaleDateString('en-US', {
	month: 'short',
	year: 'numeric',
});
const shipped = apps.find((app) => app.name === RECENTLY_SHIPPED.name);
const games = apps.filter((app) => app.category === 'Games');

const threads = [
	{
		n: '01',
		tone: 'dusk',
		kicker: 'Leverage',
		title: 'AI that does real work',
		body: 'I use AI to investigate systems, build products, automate decisions, and turn one engineer’s effort into more useful output.',
		cta: 'Read the AI entries',
		href: withBase('/blog/?tag=ai'),
	},
	{
		n: '02',
		tone: 'agave',
		kicker: 'Freedom',
		title: 'Apps, rentals, and better bets',
		body: 'I’m building income beyond a paycheck through software, real estate, and careful decisions that protect the family foundation.',
		cta: 'Read the app entries',
		href: withBase('/blog/?tag=apps'),
	},
	{
		n: '03',
		tone: 'rose',
		kicker: 'The reason',
		title: 'Family, faith, and staying present',
		body: 'Ambition only matters if it helps me show up better for Dora, the kids, and the life we are actually living now.',
		cta: 'Read the family entries',
		href: withBase('/blog/?tag=family'),
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Field notes from South Texas`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="home-hero" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow reveal">McAllen, Texas · Building in public</p>
					<h1 id="hero-title" class="reveal" style="--i: 1">
						Building technology, wealth, and a <em>meaningful</em> family life.
					</h1>
					<p class="lead reveal" style="--i: 2">
						By day I’m a principal engineer and AI architect. Nights and weekends I ship apps, manage
						rentals in South Texas, and build systems that help my family enjoy the journey while
						creating more freedom for the future.
					</p>
					<div class="hero-actions reveal" style="--i: 3">
						<a class="button" href={withBase('/blog/')}>Read the log <span class="arrow">→</span></a>
						<a class="button ghost" href="#apps">See the apps</a>
					</div>
				</div>

				<aside class="now-card reveal" style="--i: 4" aria-label="Right now">
					<div class="now-head">
						<span class="live-dot">Just shipped</span>
						<span class="mono">App Store</span>
					</div>
					<a class="now-ship" href={shipped?.url ?? '#apps'} target={shipped?.url ? '_blank' : undefined} rel="noopener">
						{shipped && <Image src={shipped.icon} width={128} height={128} alt="" loading="eager" />}
						<span>
							<strong>{RECENTLY_SHIPPED.name}</strong>
							<span>{shipped?.tagline ?? RECENTLY_SHIPPED.note}</span>
						</span>
					</a>
					<dl class="stats">
						<div><dt>apps live</dt><dd>{liveApps.length}</dd></div>
						<div><dt>log entries</dt><dd>{posts.length}</dd></div>
						<div><dt>writing since</dt><dd style="font-size: 1.15rem; padding-top: 0.55rem">{writingSince}</dd></div>
					</dl>
				</aside>
			</section>

			<div class="ticker" aria-label="Apps shipped so far">
				<div class="ticker-track">
					{[0, 1].map((copy) => (
						<ul aria-hidden={copy === 1 ? 'true' : undefined}>
							{liveApps.map((app) => (
								<li>
									<Image src={app.icon} width={52} height={52} alt="" />
									{app.name}
								</li>
							))}
						</ul>
					))}
				</div>
			</div>

			<section class="section" aria-labelledby="latest-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">Latest entry</p>
						<h2 id="latest-title">Fresh from the log</h2>
					</div>
					<a class="text-link" href={withBase('/blog/')}>All {posts.length} entries →</a>
				</header>
				<PostCard post={featured} n={numbers.get(featured.id)!} variant="feature" headingLevel="h3" />
				<div class="card-grid" style="margin-top: clamp(3rem, 6vw, 4.5rem)">
					{recent.map((post) => <PostCard post={post} n={numbers.get(post.id)!} />)}
				</div>
			</section>

			<section class="section" id="systems" aria-labelledby="threads-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">The work behind the work</p>
						<h2 id="threads-title">Three threads, one life</h2>
					</div>
					<p>Every entry pulls on at least one of these.</p>
				</header>
				<ul class="threads">
					{threads.map((thread) => (
						<li class="thread" data-tone={thread.tone}>
							<span class="thread-num" aria-hidden="true">{thread.n}</span>
							<p class="eyebrow">{thread.kicker}</p>
							<h3>{thread.title}</h3>
							<p>{thread.body}</p>
							<a class="text-link" href={thread.href}>{thread.cta} →</a>
						</li>
					))}
				</ul>
			</section>

			<section class="section" id="apps" aria-labelledby="apps-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">The app shelf</p>
						<h2 id="apps-title">{liveApps.length} apps, built nights and weekends</h2>
					</div>
					<a class="text-link" href="https://apps.apple.com/us/developer/randy-torres/id1871953838" target="_blank" rel="noopener">
						All on the App Store ↗
					</a>
				</header>
				<div class="shelf">
					<div class="segmented" role="group" aria-label="Filter apps">
						<button type="button" data-kind="all" aria-pressed="true">All<span class="count">{apps.length}</span></button>
						<button type="button" data-kind="tools" aria-pressed="false">Apps &amp; tools<span class="count">{apps.length - games.length}</span></button>
						<button type="button" data-kind="games" aria-pressed="false">Games<span class="count">{games.length}</span></button>
					</div>
					<ul class="app-grid" id="app-grid">
						{apps.map((app) => {
							const Tile = app.url ? 'a' : 'div';
							const link = app.url ? { href: app.url, target: '_blank', rel: 'noopener' } : {};
							return (
								<li data-kind={app.category === 'Games' ? 'games' : 'tools'}>
									<Tile class="app-tile" {...link}>
										<Image src={app.icon} width={152} height={152} alt="" />
										<span class="app-tile-name">{app.name}</span>
										<span class="app-tile-tag">{app.tagline}</span>
										{app.status === 'review' && <span class="badge">In review</span>}
									</Tile>
								</li>
							);
						})}
					</ul>
				</div>
			</section>

			<section class="section" id="playbooks" aria-labelledby="playbooks-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">Playbooks</p>
						<h2 id="playbooks-title">The parts of shipping that aren’t the code</h2>
						<p>Written from my own apps — the guides I reach for every time I start something new.</p>
					</div>
					<a class="text-link" href={withBase('/blog/the-three-playbooks-behind-my-app-workflow/')}>How they fit together →</a>
				</header>
				<ol class="playbooks">
					{playbooks.map((playbook, i) => (
						<li>
							<a class="playbook" href={playbook.url} target="_blank" rel="noopener">
								<span class="playbook-top">
									<span class="playbook-step">Step {String(i + 1).padStart(2, '0')}</span>
									<span class="playbook-price">{playbook.price}</span>
								</span>
								<h3>{playbook.name}</h3>
								<p>{playbook.tagline}</p>
								<span class="for">{playbook.forWhom}</span>
								<span class="go">Get it on Gumroad <span class="arrow">↗</span></span>
							</a>
						</li>
					))}
				</ol>
			</section>

			<section class="section follow" aria-labelledby="follow-title">
				<div>
					<p class="eyebrow">Follow along</p>
					<h2 id="follow-title">A new entry most weeks, <em>written as it happens.</em></h2>
					<p>Wins, misses, numbers, and the family moments in between. No algorithm required.</p>
				</div>
				<div class="hero-actions">
					<a class="button" href={withBase('/rss.xml')}>Subscribe via RSS</a>
					<a class="button ghost" href="https://github.com/RandyVentures" target="_blank" rel="noopener">GitHub ↗</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.segmented button');
			const tiles = document.querySelectorAll<HTMLLIElement>('#app-grid > li');
			buttons.forEach((button) =>
				button.addEventListener('click', () => {
					const kind = button.dataset.kind;
					buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
					tiles.forEach((tile) => (tile.hidden = kind !== 'all' && tile.dataset.kind !== kind));
				}),
			);
		</script>
	</body>
</html>
