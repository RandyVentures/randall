---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { webApps } from '../data/apps';
import { withBase } from '../lib/posts';

const title = 'Web apps by Randy Torres | Mandalo, Manifest, Heirloom, HypeLap';
const description =
	'Web apps I built that run in your browser: Mandalo payment links, Manifest App Store analytics, Heirloom cursive transcription and HypeLap live race tracking.';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Web apps',
	description,
	url: new URL('/webapps/', Astro.site).href,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: webApps.map((app, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: app.name,
			url: app.site,
		})),
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="section" aria-labelledby="webapps-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">Products</p>
						<h1 id="webapps-title">Web apps I’m building</h1>
						<p>
							These run in a browser, with no download needed. For iPhone apps and games, see the
							<a href={withBase('/apps/')}>apps page</a>.
						</p>
					</div>
				</header>
				<div class="stack">
					{webApps.map((app) => {
						const id = app.name.toLowerCase().replace(/\W+/g, '-');
						return (
							<section class="product" id={id} aria-labelledby={`${id}-title`}>
								<h2 id={`${id}-title`}>{app.name}</h2>
								<p>{app.summary}</p>
								<p><a class="text-link" href={app.site}>Open {app.name} →</a></p>
								<ul class="deep-links">
									{app.links.map((link) => (
										<li><a href={link.href}>{link.label}</a></li>
									))}
								</ul>
							</section>
						);
					})}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.stack { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
	.product { display: grid; gap: 0.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule, currentColor); }
	.deep-links { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.25rem; }
</style>
