import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Fillbook Privacy Policy"
      description="Privacy Policy for Fillbook: Trading Journal."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero policy-hero">
        <div class="hero-box">
          <p class="kicker">Fillbook · Trading Journal</p>
          <h1 class="hero-title">Your trading record stays yours.</h1>
          <p class="lead">
            Fillbook is a local-first journal for options and futures traders. This policy explains
            what the app stores and which services help provide its features.
          </p>
          <div class="hero-actions">
            <a class="button" href={import.meta.env.BASE_URL + '/fillbook/support'}>Get support</a>
            <span class="policy-date">Last updated · July 28, 2026</span>
          </div>
        </div>
      </section>

      <div class="policy-layout">
        <article class="policy tile">
          <div class="policy-heading">
            <p class="tile-kicker">Privacy policy</p>
            <h2>How Fillbook handles your data</h2>
          </div>

          <h3>Data stored by Fillbook</h3>
          <p>
            When you import a broker export, Fillbook stores the fills and journal data needed to
            group positions, evaluate your rules, and display your review history. This data is
            stored on your device. Fillbook does not require a broker login and does not transmit
            broker credentials.
          </p>
          <p>
            If iCloud sync is enabled in a future release, Apple CloudKit may synchronize your
            Fillbook journal between devices using the iCloud account you select. Fillbook does not
            sell your journal data or use it for advertising.
          </p>

          <h3>Purchases</h3>
          <p>
            In-app purchases are processed by Apple. RevenueCat is used as the subscription service
            layer to load products, process entitlement state, and restore purchases. RevenueCat
            receives purchase history and an anonymous app user identifier so it can validate
            purchases, prevent fraud, and provide subscription analytics. Fillbook does not receive
            or store your payment card information, and it does not attach purchases to your name,
            email address, or another account.
          </p>

          <h3>Analytics and advertising</h3>
          <p>
            Fillbook does not include third-party advertising or cross-app tracking. RevenueCat may
            use purchase history for subscription analytics and entitlement functionality. Imported
            fills, notes, rules, and position data are not transmitted for analytics.
          </p>

          <h3>Your choices</h3>
          <p>
            You choose which broker exports to import. You can manage subscriptions through your
            Apple account settings, and removing Fillbook and its app data removes the locally stored
            journal from that device.
          </p>

          <h3>Contact</h3>
          <p>
            For support or privacy questions, email
            <a href="mailto:randyventures06@gmail.com">randyventures06@gmail.com</a>.
          </p>
        </article>

        <aside class="policy-aside">
          <section class="tile tile-accent policy-note">
            <p class="tile-kicker">The short version</p>
            <h2>Local-first by design.</h2>
            <p>
              Your fills, notes, rules, and positions stay on your device and are not used for
              advertising or cross-app tracking.
            </p>
          </section>

          <section class="tile policy-contact">
            <p class="tile-kicker">Need a hand?</p>
            <h2>Talk to Randall Ventures.</h2>
            <p>Include your device and a short description of the issue.</p>
            <a class="button secondary" href="mailto:randyventures06@gmail.com">Email support</a>
          </section>
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .policy-hero {
    padding-top: 0;
  }

  .policy-hero .hero-box {
    background: var(--accent-tile);
    border-color: transparent;
    box-shadow: var(--shadow-1);
  }

  .policy-hero .kicker,
  .policy-hero .hero-title {
    color: var(--on-accent);
  }

  .policy-hero .lead {
    color: color-mix(in srgb, var(--on-accent) 76%, transparent);
    max-width: 42rem;
  }

  .policy-hero .button {
    background: var(--on-accent);
    color: var(--accent-tile);
  }

  .policy-date {
    align-self: center;
    color: color-mix(in srgb, var(--on-accent) 72%, transparent);
    font-size: 0.88rem;
  }

  .policy-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 14px;
    align-items: start;
  }

  .policy {
    padding: 2rem 2.1rem;
  }

  .policy-heading {
    padding-bottom: 1.3rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .policy-heading h2 {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .policy h3 {
    margin-top: 1.8rem;
    font-size: 1.25rem;
  }

  .policy h3:first-of-type {
    margin-top: 0;
  }

  .policy p {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .policy .tile-kicker,
  .policy h2,
  .policy h3 {
    font-family: var(--font-sans);
  }

  .policy .tile-kicker {
    margin-bottom: 0.65rem;
  }

  .policy-aside {
    display: grid;
    gap: 14px;
  }

  .policy-aside h2 {
    font-size: 1.35rem;
  }

  .policy-note p:not(.tile-kicker) {
    color: color-mix(in srgb, var(--on-accent) 76%, transparent);
  }

  .policy-contact p:not(.tile-kicker) {
    color: var(--ink-muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .policy-layout {
      grid-template-columns: 1fr;
    }

    .policy {
      padding: 1.5rem;
    }
  }
</style>
