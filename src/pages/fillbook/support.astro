---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Fillbook Support"
      description="Support information for Fillbook: Trading Journal."
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <section class="hero support-hero">
        <div class="hero-box">
          <p class="kicker">Fillbook · Trading Journal</p>
          <h1 class="hero-title">A clearer record of every trade.</h1>
          <p class="lead">
            Need help importing a broker export, understanding a position, or managing your
            subscription? We’re here to help.
          </p>
          <div class="hero-actions">
            <a class="button" href="mailto:randyventures06@gmail.com">Email support</a>
            <a class="button secondary" href={'/fillbook/privacy/'}>
              Privacy policy
            </a>
          </div>
        </div>
      </section>

      <div class="support-grid">
        <section class="tile tile-accent">
          <p class="tile-kicker">Contact</p>
          <h2>Reach Randall Ventures.</h2>
          <p>
            Email <a href="mailto:randyventures06@gmail.com">randyventures06@gmail.com</a> and
            include your device model, operating system version, and a short description of what
            happened.
          </p>
        </section>

        <section class="tile">
          <p class="tile-kicker">Before you write</p>
          <h2>Helpful details</h2>
          <ul>
            <li>Which screen you were using</li>
            <li>The broker export format, if importing</li>
            <li>Any error message shown by the app</li>
          </ul>
        </section>
      </div>

      <section class="tile">
        <p class="tile-kicker">Common questions</p>
        <h2>Fillbook FAQ</h2>
        <h3>Which broker exports can I import?</h3>
        <p>
          A Robinhood account activity export, a thinkorswim Account Statement export, or another
          CSV with explicit execution columns. You export once from your broker, and Fillbook never
          asks for your broker login.
        </p>
        <h3>Why are my fills grouped into one position?</h3>
        <p>
          Fillbook groups executions into positions, so a four-leg iron condor shows up as one trade
          instead of four unrelated fills. It follows rolls across expiries and keeps expiration and
          assignment visible even when there is no closing fill. When a grouping is uncertain, it
          goes to a review queue so you can confirm it before it becomes part of your journal.
        </p>
        <h3>How is realized P&amp;L counted?</h3>
        <p>
          Realized P&amp;L comes from fully closed positions and is counted on the closing date. The
          raw source row is kept for every execution, with symbols and timestamps normalized.
        </p>
        <h3>Can I try it before importing my own trades?</h3>
        <p>
          Yes. A sample book lets you explore the workflow before you import anything.
        </p>
        <h3>How do subscriptions work?</h3>
        <p>
          Choose a 7-day free trial followed by a monthly subscription, or a one-time lifetime
          purchase. Monthly access renews until canceled. Prices are shown by Apple before purchase
          and may vary by region. Manage or cancel in your Apple account settings.
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .support-hero {
    padding-top: 0;
  }

  .support-hero .hero-box {
    background: var(--accent-tile);
    border-color: transparent;
    box-shadow: var(--shadow-1);
  }

  .support-hero .kicker,
  .support-hero .hero-title {
    color: var(--on-accent);
  }

  .support-hero .lead {
    color: color-mix(in srgb, var(--on-accent) 76%, transparent);
    max-width: 42rem;
  }

  .support-hero .button {
    background: var(--on-accent);
    color: var(--accent-tile);
  }

  .support-hero .button.secondary {
    background: transparent;
    color: var(--on-accent);
    border-color: color-mix(in srgb, var(--on-accent) 35%, transparent);
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 14px;
  }

  .support-grid h2 {
    font-size: 1.45rem;
  }

  .support-grid p,
  .support-grid li {
    color: color-mix(in srgb, var(--on-accent) 76%, transparent);
  }

  .support-grid > .tile:not(.tile-accent) p,
  .support-grid > .tile:not(.tile-accent) li {
    color: var(--ink-muted);
  }

  .support-grid ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .support-grid li + li {
    margin-top: 0.55rem;
  }

  @media (max-width: 760px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
