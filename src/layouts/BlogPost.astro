---
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import PostCover from '../components/PostCover.astro';
import { toneFor } from '../data/tags';
import { type Post, formatEntry, postUrl, readingTime, titleTransition, withBase } from '../lib/posts';

interface Props {
	post: Post;
	n: number;
	headings: MarkdownHeading[];
	prev?: { post: Post; n: number };
	next?: { post: Post; n: number };
	related: { post: Post; n: number }[];
}

const { post, n, headings, prev, next, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const minutes = readingTime(post);

// A contents list only earns its space once there is something to navigate.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — Randall`} description={description} image={heroImage} publishedDate={pubDate} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			author: { '@type': 'Person', name: 'Randall Torres', url: new URL(withBase('/about/'), Astro.site).href },
			mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
		})} />
	</head>

	<body>
		<div class="progress" id="progress" aria-hidden="true"></div>
		<Header />
		<main id="main">
			<article id="article">
				<header class="article-head">
					<nav class="crumbs reveal" aria-label="Breadcrumb">
						<a href={withBase('/blog/')}>The log</a>
						<span class="sep" aria-hidden="true">/</span>
						<span class="current" aria-current="page">{formatEntry(n)}</span>
					</nav>
					<h1 style={titleTransition(post.id)}>{title}</h1>
					{description && <p class="deck reveal" style="--i: 1">{description}</p>}
					<div class="byline reveal" style="--i: 2">
						<a class="who" href={withBase('/about/')} style="color: inherit">
							<span class="avatar" aria-hidden="true">R</span>
							Randall Torres
						</a>
						<span class="sep" aria-hidden="true"></span>
						<FormattedDate date={pubDate} />
						<span class="sep" aria-hidden="true"></span>
						<span>{minutes} min read</span>
						{updatedDate && (
							<>
								<span class="sep" aria-hidden="true"></span>
								<span>Updated <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
					{tags.length > 0 && (
						<div class="chip-row reveal" style="--i: 3; justify-content: center">
							{tags.map((tag) => (
								<a class="chip" data-tone={toneFor(tag)} href={withBase(`/blog/?tag=${tag}`)}>{tag}</a>
							))}
						</div>
					)}
				</header>

				{heroImage && (
					<figure class="article-hero reveal" style="--i: 3; margin-inline: auto">
						<PostCover post={post} n={n} width={1600} sizes="(max-width: 1100px) 100vw, 1040px" eager />
					</figure>
				)}

				<div class:list={['article-layout', { 'no-toc': !showToc }]}>
					<div>
						{showToc && (
							<details class="toc-mobile">
								<summary>
									On this page
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
								</summary>
								<ol>
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
									))}
								</ol>
							</details>
						)}

						<div class="prose" id="prose">
							<slot />
						</div>

						<footer class="article-end">
							<div class="fin" aria-hidden="true">✦</div>
							<div class="share">
								<span class="share-label">Share this entry</span>
								<button class="button small ghost" type="button" id="copy-link">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
									<span>Copy link</span>
								</button>
								<a
									class="button small ghost"
									href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`}
									target="_blank"
									rel="noopener"
								>LinkedIn ↗</a>
								<button class="button small ghost" type="button" id="native-share" hidden>Share…</button>
							</div>
							<aside class="author" aria-labelledby="author-name">
								<span class="avatar" aria-hidden="true">R</span>
								<div>
									<h2 id="author-name">Written by Randall Torres</h2>
									<p>
										Principal engineer in Architecture, supporting the AI and Payments teams. Based in
										McAllen, Texas — shipping apps, managing
										rentals, and trying not to miss the family life happening along the way.
									</p>
									<div class="author-links">
										<a class="text-link" href={withBase('/about/')}>More about me →</a>
										<a class="text-link" href={withBase('/rss.xml')}>Subscribe via RSS</a>
									</div>
								</div>
							</aside>
						</footer>
					</div>

					{showToc && (
						<nav class="toc" aria-labelledby="toc-title">
							<p class="toc-title" id="toc-title">On this page</p>
							<ol id="toc-list">
								{toc.map((h) => (
									<li class={`depth-${h.depth}`}><a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a></li>
								))}
							</ol>
						</nav>
					)}
				</div>
			</article>

			{(prev || next) && (
				<nav class="pager" aria-label="More entries">
					{prev && (
						<a href={postUrl(prev.post.id)} rel="prev">
							<span class="pager-label">← Older · {formatEntry(prev.n)}</span>
							<span class="pager-title">{prev.post.data.title}</span>
						</a>
					)}
					{next && (
						<a class="next" href={postUrl(next.post.id)} rel="next">
							<span class="pager-label">Newer · {formatEntry(next.n)} →</span>
							<span class="pager-title">{next.post.data.title}</span>
						</a>
					)}
				</nav>
			)}

			{related.length > 0 && (
				<section class="section" aria-labelledby="related-title" style="margin-top: clamp(3.5rem, 7vw, 5rem)">
					<header class="section-header">
						<div>
							<p class="eyebrow">Keep reading</p>
							<h2 id="related-title">Related entries</h2>
						</div>
						<a class="text-link" href={withBase('/blog/')}>The full log →</a>
					</header>
					<div class="card-grid">
						{related.map((item) => <PostCard post={item.post} n={item.n} morph={false} />)}
					</div>
				</section>
			)}
		</main>

		<button class="icon-button back-to-top" id="back-to-top" type="button" aria-label="Back to top">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
		</button>
		<Footer />

		<script>
			const prose = document.getElementById('prose')!;
			const progress = document.getElementById('progress')!;
			const toTop = document.getElementById('back-to-top')!;

			// Reading progress tracks the article itself, not the whole page.
			let ticking = false;
			function update() {
				ticking = false;
				const rect = prose.getBoundingClientRect();
				const span = rect.height - window.innerHeight * 0.6;
				const p = Math.min(1, Math.max(0, -rect.top / Math.max(1, span)));
				progress.style.setProperty('--progress', String(p));
				toTop.toggleAttribute('data-visible', window.scrollY > window.innerHeight * 1.2);
			}
			window.addEventListener(
				'scroll',
				() => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				},
				{ passive: true },
			);
			window.addEventListener('resize', update);
			update();
			toTop.addEventListener('click', () => {
				window.scrollTo({ top: 0 });
				(document.querySelector('.brand') as HTMLElement | null)?.focus({ preventScroll: true });
			});

			// Hover anchors on headings, so any section can be linked directly.
			prose.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]').forEach((heading) => {
				const anchor = document.createElement('a');
				anchor.className = 'heading-anchor';
				anchor.href = `#${heading.id}`;
				anchor.textContent = '#';
				anchor.setAttribute('aria-label', `Link to “${heading.textContent}”`);
				heading.prepend(anchor);
			});

			// Scrollspy: the contents list follows along with the reader.
			const tocLinks = new Map(
				[...document.querySelectorAll<HTMLAnchorElement>('#toc-list a')].map((a) => [a.dataset.slug!, a]),
			);
			if (tocLinks.size) {
				const headings = [...tocLinks.keys()]
					.map((slug) => document.getElementById(slug))
					.filter((h): h is HTMLElement => Boolean(h));
				const setCurrent = () => {
					const line = window.innerHeight * 0.3;
					let current = headings[0];
					for (const heading of headings) {
						if (heading.getBoundingClientRect().top <= line) current = heading;
					}
					tocLinks.forEach((link, slug) => link.setAttribute('aria-current', String(slug === current?.id)));
				};
				window.addEventListener('scroll', () => requestAnimationFrame(setCurrent), { passive: true });
				setCurrent();
			}

			// Sharing
			const copy = document.getElementById('copy-link')!;
			const label = copy.querySelector('span')!;
			copy.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(location.href.split('#')[0]);
					label.textContent = 'Copied!';
					copy.setAttribute('data-copied', '');
					setTimeout(() => {
						label.textContent = 'Copy link';
						copy.removeAttribute('data-copied');
					}, 1800);
				} catch {
					label.textContent = 'Press ⌘C';
				}
			});
			const share = document.getElementById('native-share')!;
			if ('share' in navigator) {
				share.hidden = false;
				share.addEventListener('click', () => {
					navigator.share({ title: document.title, url: location.href.split('#')[0] }).catch(() => {});
				});
			}
		</script>
	</body>
</html>
